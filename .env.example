# Токен бота от @BotFather
BOT_TOKEN=

# Куда присылать ответы клиентов (узнать: написать боту /myid)
ADMIN_CHAT_ID=

# Распознавание голосовых: Yandex SpeechKit
STT_PROVIDER=yandex
# API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_API_KEY=
# ID каталога в Yandex Cloud (можно не указывать, если ключ сервисного аккаунта)
YANDEX_FOLDER_ID=

# Спрашивать согласие на обработку персональных данных перед интервью (1 — да). Пока выключено.
CONSENT_REQUIRED=

# Ссылка на полную политику обработки персональных данных (кнопка «Подробнее» при согласии).
# Пока не задана, бот показывает краткое описание сам.
PRIVACY_URL=

# Через сколько часов напоминать тем, кто бросил интервью (по умолчанию 24,72).
# Для проверки можно поставить, например, 0.05,0.1 — это 3 и 6 минут.
REMINDER_HOURS=
